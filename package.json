{
  "name": "po-delam",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "cron": "node scripts/cron.js",
    "start:windows": "start npm run dev && start npm run cron",
    "build": "prisma generate && next build",
    "start": "prisma migrate deploy && concurrently --kill-others-on-fail \"next start\" \"node scripts/cron.js\"",
    "lint": "node node_modules/eslint/bin/eslint.js src --ext .ts,.tsx --no-cache",
    "typecheck": "tsc --noEmit --incremental false",
    "db:validate": "prisma validate",
    "db:deploy": "prisma migrate deploy",
    "bot:webhook": "node scripts/setup-max-webhook.js",
    "verify": "npm run typecheck && npm run lint && npm run db:validate",
    "test": "node --experimental-strip-types tests/all.test.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "clsx": "2.1.1",
    "concurrently": "10.0.5",
    "framer-motion": "11.18.2",
    "lucide-react": "0.323.0",
    "next": "15.5.24",
    "pg": "8.20.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "2.6.1",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@types/node": "20.19.39",
    "@types/pg": "8.20.0",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "autoprefixer": "10.5.0",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.24",
    "postcss": "8.5.26",
    "prisma": "7.9.1",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "postcss": "8.5.26",
    "fast-uri": "3.1.6",
    "mysql2": "3.24.0",
    "brace-expansion": "1.1.18",
    "browserslist": "4.28.7",
    "js-yaml": "4.3.1",
    "postcss-selector-parser": "6.1.3"
  }
}
